# Hosted LibreTranslate example. Configure your provider's URL and server-only key.
# TRANSLATION_PROVIDER=libretranslate
# TRANSLATION_API_URL=https://translate.example.com/translate
# TRANSLATION_API_KEY=server-only-secret

# Free hosted fallback option (not open source; opt in explicitly).
# TRANSLATION_PROVIDER=mymemory
# TRANSLATION_API_URL=https://api.mymemory.translated.net/get
# TRANSLATION_MYMEMORY_EMAIL=optional-contact@example.com

# Optional self-hosted Google Translate-compatible proxy.
# TRANSLATION_PROVIDER=free-translate-api
# TRANSLATION_API_URL=http://localhost:8000/translate

# DeepL API Free (a DeepL Translator/Pro subscription alone is not sufficient;
# use an API Free or API Pro authentication key). Secrets remain server-only.
# TRANSLATION_PROVIDER=deepl
# TRANSLATION_API_URL=https://api-free.deepl.com
# TRANSLATION_API_KEY=your-deepl-api-free-key

# DeepL API Pro
# TRANSLATION_PROVIDER=deepl
# TRANSLATION_API_URL=https://api.deepl.com
# TRANSLATION_API_KEY=your-deepl-api-pro-key

# Optional local, durable translation-memory directory. One file is created for
# each target language (for example .translation-cache/es.json). Do not point
# this at a public directory or commit its contents.
# TRANSLATION_MEMORY_DIR=.translation-cache

# Optional alternative provider retained for benchmarking/backward compatibility.
# TRANSLATION_PROVIDER=openai-compatible
# TRANSLATION_API_URL=https://your-provider.example/v1/chat/completions
# TRANSLATION_API_KEY=server-only-secret
# TRANSLATION_MODEL=your-model
